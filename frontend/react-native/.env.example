# Copy to .env. Base URL of the backend.
#
# Unset falls back to localhost. See config.ts:
#   Android emulator uses 10.0.2.2, everything else localhost.
#
# A physical phone cannot reach localhost. Use your LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
#
# For EAS builds, set this in eas.json instead.
EXPO_PUBLIC_API_URL=
